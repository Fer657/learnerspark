# ---------------------------------------------------------------------------
# Learners Park — environment configuration (all optional)
#
# The site is fully functional with NO variables set: CSSS and OPAM run
# on-device, results are saved in the browser, and no account is required.
# Set the variables below only to enable the optional backend features.
# ---------------------------------------------------------------------------

# Account + attempt-sync service base URL (no trailing slash).
# When unset (or set to "off"), the platform runs entirely on-device with a
# "Continue as guest" flow and no login.
# VITE_STUDENT_API_URL=https://accounts.example.com

# Admin console URL shown in the header/footer. When unset, the link is hidden.
# VITE_ADMIN_CONSOLE_URL=https://accounts.example.com/admin/login

# Analytics (leave blank to disable; blank values are stripped safely at build).
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
